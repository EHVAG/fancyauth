<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="EntityFramework6.Npgsql" Version="6.4.3" />
    <!-- Npgsql 5, not the 4.1 EntityFramework6.Npgsql is built against: 4.1 offers at most TLS 1.2, and CloudNativePG requires 1.3.
         Npgsql 6 and later write timestamps differently. -->
    <PackageReference Include="Npgsql" Version="5.0.18" />
  </ItemGroup>
</Project>
